//@version=5
strategy("Yapay Zeka Kuant Fon Algoritmasi - v3 Gercekci", 
         overlay=true, 
         initial_capital=1000000, 
         process_orders_on_close=true, 
         pyramiding=20,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=2)

// ======================================================================================
// v3 EKLEMELER (gercekci alim-satim icin):
// 1. VWAP -> ta.vwap (v2'den)
// 2. Exit emri yigilmasi -> strategy.cancel (v2'den)
// 3. Piramit bayrak reset (v2'den)
// 4. Zaman stopu -> bar_index (v2'den)
// 5. Boga tespiti -> 3 mum konfirmasyon (v2'den)
// 6. Asama 1 stop -> math.min kilidi (v2'den)
// 7. YENİ: Komisyon %0.1 + slipaj 2 tick
// 8. YENİ: Hacim filtresi (ortalamanin 1.5 kati)
// 9. YENİ: Max drawdown korumasi (%20)
// 10. YENİ: Piyasa rejimi filtresi (BIST100 endeks kontrolu)
// 11. YENİ: Sabit risk bazli pozisyon buyuklugu (%1 risk per trade)
// 12. YENİ: Islem saati filtresi (10:30 - 17:00)
// ======================================================================================

// --- Girdiler ---
bist_periyot      = input.int(21,   title="BIST 100 Ana Filtre")
max_spread        = input.float(5.0, title="Maksimum Ortalama Uzakligi (%)") / 100
komisyon_oran     = input.float(0.1, title="Komisyon (%)") / 100
max_drawdown_pct  = input.float(20.0, title="Maks Drawdown Limiti (%)") / 100
risk_per_trade    = input.float(1.0,  title="Islem Basi Risk (%)") / 100
hacim_carpan      = input.float(1.5,  title="Hacim Filtresi Carpani")

// --- 1. Tarih Filtresi ---
tarih_uygun = (year >= 2016)

// --- 2. [YENİ 12] Islem Saati Filtresi - BIST 10:00-18:00, ilk ve son 30dk disla ---
saat_uygun = (hour > 10 or (hour == 10 and minute >= 30)) and (hour < 17 or (hour == 17 and minute == 0))

// --- 3. Oynaklik Analizi ---
atr_klasik = ta.atr(14)
hiz_onayi  = ta.change(atr_klasik) > 0

// --- 4. [DUZELTME 5] Boga Tespiti - 3 Mum Konfirmasyon ---
bist_ema    = ta.ema(close, bist_periyot)
boga_kosulu = close > bist_ema
piyasa_boga = boga_kosulu and boga_kosulu[1] and boga_kosulu[2]

// Dinamik Zaman Stopu Siniri
zaman_stopu_siniri = piyasa_boga ? 5 : 2

// --- 5. [YENİ 10] Piyasa Rejimi Filtresi - BIST100 Endeks ---
endeks       = request.security("BIST:XU100", timeframe.period, close)
endeks_ema50 = ta.ema(endeks, 50)
endeks_yukari = endeks > endeks_ema50 and endeks > endeks_ema50[1]  // Endeks yukari trendde mi?

// --- 6. [DUZELTME 1] VWAP - ta.vwap ile dogru hesap ---
vwap_uygun = close > ta.vwap

// Bollinger Bantlari
orta_bant      = ta.sma(close, 20)
standart_sapma = ta.stdev(close, 20)
dinamik_sapma  = hiz_onayi ? 2.4 : 1.8
ust_bant       = orta_bant + (dinamik_sapma * standart_sapma)
bb_uygun       = close < ust_bant

// --- 7. Trend ve Guc Gostergeleri ---
ema_8  = ta.ema(close, 8)
ema_12 = ta.ema(close, 12)
ema_17 = ta.ema(close, 17)
ema_26 = ta.ema(close, 26)

macd_hizli_ema = hiz_onayi ? ema_8  : ema_12
macd_yavas_ema = hiz_onayi ? ema_17 : ema_26

macdLine   = macd_hizli_ema - macd_yavas_ema
signalLine = ta.ema(macdLine, 9)
macd_al    = macdLine > signalLine

[_, _, adx] = ta.dmi(14, 14)
adx_guclu  = adx > 20
mfi_uygun  = ta.mfi(close, 14) > 40

// --- 8. [YENİ 8] Hacim Filtresi ---
hacim_ortalama = ta.sma(volume, 20)
hacim_uygun    = volume > hacim_ortalama * hacim_carpan

// --- 9. Dinamik Kasa Yonetimi ---
kasa_orani      = piyasa_boga ? (adx > 30 ? 10.0 : 5.0) : 3.0
ilk_giris_orani = kasa_orani * 0.5

// --- 10. [YENİ 9] Max Drawdown Korumasi ---
var float en_yuksek_equity = strategy.initial_capital
if (strategy.equity > en_yuksek_equity)
    en_yuksek_equity := strategy.equity

drawdown_pct    = (en_yuksek_equity - strategy.equity) / en_yuksek_equity
sermaye_saglikli = drawdown_pct < max_drawdown_pct

// --- 11. Alim Stratejisi ---
v_ema13    = ta.ema(close, 13)
v_ema34    = ta.ema(close, 34)
sinyal_ema = piyasa_boga ? v_ema13 : v_ema34

spread_uygun = (close - sinyal_ema) / sinyal_ema <= max_spread

pvt_degeri = ta.cum(ta.change(close) / close * volume)
cmf_uygun  = ta.sma(pvt_degeri, 20) > ta.sma(pvt_degeri, 50)

// Tum filtreler bir arada
al_kosulu = (close > sinyal_ema) and 
             macd_al and 
             bb_uygun and 
             adx_guclu and 
             mfi_uygun and 
             spread_uygun and 
             vwap_uygun and 
             tarih_uygun and 
             saat_uygun and          // [YENİ 12]
             hacim_uygun and         // [YENİ 8]
             endeks_yukari and       // [YENİ 10]
             sermaye_saglikli        // [YENİ 9]

// --- 12. Durum Degiskenleri ---
var float giris_fiyati    = na
var float en_yuksek_fiyat = na
var int   asama           = 0
var bool  piramit_yapildi = false
var int   giris_bar       = 0

// --- 13. Yeni Pozisyon Acilisi ---
if (al_kosulu and strategy.position_size == 0)

    // [YENİ 11] Sabit risk bazli pozisyon buyuklugu
    // Stop mesafesi belli olmadan once ATR'yi kullan
    atr_giris     = ta.atr(14)
    stop_mesafe   = (piyasa_boga ? 1.5 : 2.2) * atr_giris
    risk_tutari   = strategy.equity * risk_per_trade
    kontrat_adedi = risk_tutari / stop_mesafe

    // Kasa orani ile cap: ikisinden kucugunu sec
    kasa_kontrat  = (strategy.equity * (ilk_giris_orani / 100)) / close
    kontrat_final = math.min(kontrat_adedi, kasa_kontrat)

    strategy.entry("KuantAl", strategy.long, qty=kontrat_final)
    giris_fiyati      := close
    en_yuksek_fiyat   := close
    asama             := 0
    piramit_yapildi   := false
    giris_bar         := bar_index

// --- 14. Pozisyon Kapaninca Bayragi Sifirla ---
if (strategy.position_size == 0 and not na(giris_fiyati))
    piramit_yapildi := false
    giris_fiyati    := na

// --- 15. Pozisyon Yonetimi ---
if (strategy.position_size > 0)

    if (high > en_yuksek_fiyat)
        en_yuksek_fiyat := high

    atr_10 = ta.atr(10)
    atr_14 = ta.atr(14)
    atr    = hiz_onayi ? atr_10 : atr_14

    esik_baslangic = (2.0 * atr) / giris_fiyati
    esik_ucus      = (4.0 * atr) / giris_fiyati
    guncel_kar     = (en_yuksek_fiyat - giris_fiyati) / giris_fiyati

    if (guncel_kar >= esik_baslangic and guncel_kar < esik_ucus)
        asama := 1
    else if (guncel_kar >= esik_ucus)
        asama := 2

    // --- Piramit Ekleme ---
    if (asama == 1 and not piramit_yapildi and (strategy.position_size * close) < (strategy.equity * (kasa_orani / 100)))
        ek_kontrat      = (strategy.equity * (ilk_giris_orani / 100)) / close
        strategy.entry("KuantAl", strategy.long, qty=ek_kontrat)
        piramit_yapildi := true

    // --- Stop-Loss Hesabi ---
    float hesaplanan_stop = na

    if (asama == 0)
        hesaplanan_stop := giris_fiyati - (piyasa_boga ? 1.5 : 2.2) * atr
    else if (asama == 1)
        // math.min: kar kilidi + fiyat altı garantisi
        potansiyel_stop = strategy.position_avg_price * (1 + esik_baslangic)
        emniyet_baraji  = close * 0.995
        hesaplanan_stop := math.min(potansiyel_stop, emniyet_baraji)
    else if (asama == 2)
        dinamik_takip_payi = (1.5 * atr) / close
        hesaplanan_stop    := en_yuksek_fiyat * (1 - dinamik_takip_payi)

    strategy.cancel("Cikis")
    strategy.exit("Cikis", "KuantAl", stop=hesaplanan_stop)

// --- 16. Zaman Stopu ---
if (strategy.position_size > 0 and (bar_index - giris_bar) >= zaman_stopu_siniri and asama == 0)
    strategy.close("KuantAl", comment="Kuant Zaman Stopu")

// --- 17. Gosterge Paneli ---
var table bilgi = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(bilgi, 0, 0, "Drawdown",      text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 0, str.tostring(math.round(drawdown_pct * 100, 2)) + "%", 
               text_color=drawdown_pct > 0.15 ? color.red : color.green, text_size=size.small)
    table.cell(bilgi, 0, 1, "Sermaye",        text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 1, str.tostring(math.round(strategy.equity, 0)), text_color=color.white, text_size=size.small)
    table.cell(bilgi, 0, 2, "Piyasa",         text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 2, piyasa_boga ? "BOGA" : "AYI", 
               text_color=piyasa_boga ? color.green : color.red, text_size=size.small)
    table.cell(bilgi, 0, 3, "Endeks Trend",   text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 3, endeks_yukari ? "YUKARI" : "ASAGI", 
               text_color=endeks_yukari ? color.green : color.red, text_size=size.small)
    table.cell(bilgi, 0, 4, "Hacim",          text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 4, hacim_uygun ? "YETERLI" : "YETERSIZ", 
               text_color=hacim_uygun ? color.green : color.red, text_size=size.small)
    table.cell(bilgi, 0, 5, "Islem Saati",    text_color=color.white, text_size=size.small)
    table.cell(bilgi, 1, 5, saat_uygun ? "UYGUN" : "DISINDA", 
               text_color=saat_uygun ? color.green : color.red, text_size=size.small)
